// SPDX-License-Identifier: MIT
// SplatMorph.compute — lerps matched splat pairs between two GaussianSplatAssets.
// Output is always in Left asset's format (Norm11 pos, Norm6 scale, Norm8x4 color).
// One thread per matched pair. B-side indices are sorted ascending for sequential reads on Adreno.

#pragma kernel MorphSplats
#pragma kernel CopyUnmatchedA
#pragma kernel CopyUnmatchedB

#include "GaussianSplatting.hlsl"

// ── Index buffer ──────────────────────────────────────────────────────────────
// int2 per pair: x = index into A, y = index into B (sorted ascending by y)
StructuredBuffer<int2> _MorphPairs;

// ── Source buffers ────────────────────────────────────────────────────────────
ByteAddressBuffer _PosA;
ByteAddressBuffer _PosB;
ByteAddressBuffer _OtherA;
ByteAddressBuffer _OtherB;
ByteAddressBuffer _SHA;
ByteAddressBuffer _SHB;
Texture2D<float4> _ColorA;
Texture2D<float4> _ColorB;

// Chunk bounds for dechunking pos
ByteAddressBuffer _ChunksA;
ByteAddressBuffer _ChunksB;
uint _ChunkCountA;
uint _ChunkCountB;

// ── Output buffers ────────────────────────────────────────────────────────────
RWByteAddressBuffer _OutPos;
RWByteAddressBuffer _OutOther;
RWByteAddressBuffer _OutSH;
RWTexture2D<float4> _OutColor;

// ── Params ────────────────────────────────────────────────────────────────────
float _T;
uint _MorphCount;
uint _SplatFormatA;  // pos=bits[7:0] scale=bits[15:8]
uint _SplatFormatB;
uint _OutWidth;      // output color texture width (sized to totalMorphCount)
uint _OutWidthB;     // B source texture width (may differ from _OutWidth)

// Unmatched-copy params (CopyUnmatchedA / CopyUnmatchedB)
StructuredBuffer<int> _UnmatchedIndices;
uint _UnmatchedCount;
uint _OutOffset;     // first output index for this unmatched block
float3 _OutBoundsMin;
float3 _OutBoundsMax;

// ── Format constants (match GaussianSplatAsset.VectorFormat) ─────────────────
#define FMT_32F 0
#define FMT_16  1
#define FMT_11  2
#define FMT_6   3

// ── Output chunk pre-encode helpers ──────────────────────────────────────────
// The renderer's LoadSplatData() always runs its dechunk path for morph output
// (_SplatChunkCount > 0): col = lerp(colMin,colMax,col); col.a = InvSquareCentered01(col.a);
// scale = lerp(sclMin,sclMax,scale); scale = scale^8.
// The morpher sets colMin/colMax = (0,1) and sclMin/sclMax = (0,1) (identity lerp), so RGB
// passes through unchanged, but alpha and scale need the matching forward transform here so
// the renderer's InvSquareCentered01 / ^8 recover the real values.
float SquareCentered01(float x)
{
    x -= 0.5;
    x = x * x * sign(x);
    return x * 2.0 + 0.5;
}

float3 EncodeChunkScale(float3 scale)
{
    return pow(max(scale, 0.0), 1.0 / 8.0);
}

// Decode a chunk-relative normalised scale to final scale, matching the renderer's
// LoadSplatData dechunk path: scale = lerp(sclMin,sclMax,scale); scale = scale^8.
// ChunkInfo layout: sclX/sclY/sclZ at bytes 40/44/48, each a packed half2(min,max).
float3 DecodeChunkScale(float3 normScale, ByteAddressBuffer chunks, uint chunkCount, uint splatIdx)
{
    uint chunkIdx = splatIdx / 256u;
    if (chunkIdx >= chunkCount) return normScale;
    uint base = chunkIdx * 64;
    uint2 sX = chunks.Load(base + 40) >> uint2(0, 16) & 0xFFFF;
    uint2 sY = chunks.Load(base + 44) >> uint2(0, 16) & 0xFFFF;
    uint2 sZ = chunks.Load(base + 48) >> uint2(0, 16) & 0xFFFF;
    float3 sclMin = float3(f16tof32(sX.x), f16tof32(sY.x), f16tof32(sZ.x));
    float3 sclMax = float3(f16tof32(sX.y), f16tof32(sY.y), f16tof32(sZ.y));
    float3 scale = lerp(sclMin, sclMax, normScale);
    scale = scale * scale; scale = scale * scale; scale = scale * scale;
    return scale;
}

// ── Decode helpers ────────────────────────────────────────────────────────────

float3 DecodeNorm11(uint enc)
{
    return float3(
        (enc & 2047u)         / 2047.0,
        ((enc >> 11) & 1023u) / 1023.0,
        ((enc >> 21) & 2047u) / 2047.0);
}

uint EncodeNorm11(float3 v)
{
    v = saturate(v);
    return (uint)(v.x * 2047.0 + 0.5)
         | ((uint)(v.y * 1023.0 + 0.5) << 11)
         | ((uint)(v.z * 2047.0 + 0.5) << 21);
}

float3 DecodeNorm6(uint enc)
{
    return float3(
        (enc & 31u)          / 31.0,
        ((enc >> 5) & 63u)   / 63.0,
        ((enc >> 11) & 31u)  / 31.0);
}

uint EncodeNorm6(float3 v)
{
    v = saturate(v);
    return (uint)(v.x * 31.0 + 0.5)
         | ((uint)(v.y * 63.0 + 0.5) << 5)
         | ((uint)(v.z * 31.0 + 0.5) << 11);
}

// Decode a vector from a ByteAddressBuffer given byte offset and format
float3 DecodeVec(ByteAddressBuffer buf, uint byteOffset, uint fmt)
{
    if (fmt == FMT_11)
        return DecodeNorm11(buf.Load(byteOffset));
    if (fmt == FMT_6)
        return DecodeNorm6(buf.Load(byteOffset) & 0xFFFF);
    if (fmt == FMT_16)
    {
        uint2 raw = buf.Load2(byteOffset);
        return float3((raw.x & 0xFFFF) / 65535.0,
                      (raw.x >> 16)    / 65535.0,
                      (raw.y & 0xFFFF) / 65535.0);
    }
    // FMT_32F
    return asfloat(buf.Load3(byteOffset));
}

uint PosStride(uint fmt)
{
    if (fmt == FMT_11) return 4;
    if (fmt == FMT_6)  return 2;
    if (fmt == FMT_16) return 6;
    return 12; // FMT_32F
}

// Dechunk a normalised pos using chunk bounds (kChunkSize = 256)
float3 Dechunk(float3 normPos, ByteAddressBuffer chunks, uint chunkCount, uint splatIdx)
{
    uint chunkIdx = splatIdx / 256u;
    if (chunkIdx >= chunkCount) return normPos;
    // ChunkInfo layout: col(16B) | posX.xy(8B) | posY.xy(8B) | posZ.xy(8B) | ...
    uint base = chunkIdx * 64; // sizeof(ChunkInfo) = 64 bytes
    float posXMin = asfloat(chunks.Load(base + 16));
    float posXMax = asfloat(chunks.Load(base + 20));
    float posYMin = asfloat(chunks.Load(base + 24));
    float posYMax = asfloat(chunks.Load(base + 28));
    float posZMin = asfloat(chunks.Load(base + 32));
    float posZMax = asfloat(chunks.Load(base + 36));
    return float3(
        lerp(posXMin, posXMax, normPos.x),
        lerp(posYMin, posYMax, normPos.y),
        lerp(posZMin, posZMax, normPos.z));
}

// Decode a chunk-relative color texel to final RGBA, matching the renderer's
// LoadSplatData dechunk path: col = lerp(colMin,colMax,col); col.a = InvSquareCentered01(col.a).
// ChunkInfo layout: colR/colG/colB/colA at bytes 0/4/8/12, each a packed half2(min,max).
float4 DecodeChunkColor(float4 raw, ByteAddressBuffer chunks, uint chunkCount, uint splatIdx)
{
    uint chunkIdx = splatIdx / 256u;
    if (chunkIdx >= chunkCount) return raw;
    uint base = chunkIdx * 64;
    uint2 cR = chunks.Load(base + 0)  >> uint2(0, 16) & 0xFFFF;
    uint2 cG = chunks.Load(base + 4)  >> uint2(0, 16) & 0xFFFF;
    uint2 cB = chunks.Load(base + 8)  >> uint2(0, 16) & 0xFFFF;
    uint2 cA = chunks.Load(base + 12) >> uint2(0, 16) & 0xFFFF;
    float4 colMin = float4(f16tof32(cR.x), f16tof32(cG.x), f16tof32(cB.x), f16tof32(cA.x));
    float4 colMax = float4(f16tof32(cR.y), f16tof32(cG.y), f16tof32(cB.y), f16tof32(cA.y));
    float4 col = lerp(colMin, colMax, raw);
    col.a = InvSquareCentered01(col.a);
    return col;
}

// Pack a final RGBA into the morph output's color texture, whose chunk uses identity
// (0,1) colMin/colMax — RGB passes through unchanged, alpha is forward-encoded so the
// renderer's InvSquareCentered01 recovers it.
float4 EncodeOutputColor(float4 col)
{
    col.a = SquareCentered01(col.a);
    return col;
}

// Decode rotation (10.10.10.2 packed uint) → float4 quaternion
float4 DecodeRot(uint enc)
{
    return float4(
        ((enc >>  0) & 1023u) / 1023.0 * 2.0 - 1.0,
        ((enc >> 10) & 1023u) / 1023.0 * 2.0 - 1.0,
        ((enc >> 20) & 1023u) / 1023.0 * 2.0 - 1.0,
        ((enc >> 30) & 3u)    /    3.0 * 2.0 - 1.0);
}

uint EncodeRot(float4 q)
{
    q = saturate(q * 0.5 + 0.5);
    return (uint)(q.x * 1023.0 + 0.5)
         | ((uint)(q.y * 1023.0 + 0.5) << 10)
         | ((uint)(q.z * 1023.0 + 0.5) << 20)
         | ((uint)(q.w *    3.0 + 0.5) << 30);
}

uint OtherStride(uint fmt)
{
    if (fmt == FMT_11) return 4 + 4; // rot(4) + scale_norm11(4)
    if (fmt == FMT_6)  return 4 + 2; // rot(4) + scale_norm6(2)
    if (fmt == FMT_16) return 4 + 6;
    return 4 + 12; // FMT_32F
}

// The output Other buffer is always packed as rot(4, 10.10.10.2) + scale(4, Norm6) — the
// morph kernels never preserve the source scale format. OtherStride(scaleFmtA) must not be
// used for output writes/allocation, since it reflects the SOURCE stride, not this layout.
#define OUT_OTHER_STRIDE 8u

uint2 SplatToTexCoord(uint idx, uint texWidth)
{
    // Color textures use the renderer's Morton 16x16 swizzle (see SplatIndexToPixelIndex
    // in GaussianSplatting.hlsl) — must match or reads/writes land on the wrong texel.
    uint2 xy = DecodeMorton2D_16x16(idx);
    uint width = texWidth / 16;
    uint blockIdx = idx >> 8;
    return uint2((blockIdx % width) * 16 + xy.x, (blockIdx / width) * 16 + xy.y);
}

// ── Main kernel ───────────────────────────────────────────────────────────────

[numthreads(64, 1, 1)]
void MorphSplats(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _MorphCount) return;

    int2 pair  = _MorphPairs[i];
    uint idxA  = (uint)pair.x;
    uint idxB  = (uint)pair.y;
    float t    = _T;

    uint posFmtA  = _SplatFormatA & 0xFF;
    uint scaleFmtA = (_SplatFormatA >> 8) & 0xFF;
    uint posFmtB  = _SplatFormatB & 0xFF;
    uint scaleFmtB = (_SplatFormatB >> 8) & 0xFF;

    // ── Position ─────────────────────────────────────────────────────────────
    float3 normPosA = DecodeVec(_PosA, idxA * PosStride(posFmtA), posFmtA);
    float3 normPosB = DecodeVec(_PosB, idxB * PosStride(posFmtB), posFmtB);

    float3 worldPosA = Dechunk(normPosA, _ChunksA, _ChunkCountA, idxA);
    float3 worldPosB = Dechunk(normPosB, _ChunksB, _ChunkCountB, idxB);
    float3 worldPos  = lerp(worldPosA, worldPosB, t);

    // Normalize world pos into output chunk bounds [0,1] — renderer dechunks with the single output chunk.
    float3 range = max(_OutBoundsMax - _OutBoundsMin, 1e-6);
    float3 normOut = saturate((worldPos - _OutBoundsMin) / range);
    _OutPos.Store(i * 4, EncodeNorm11(normOut));

    // ── Other (rotation + scale) ──────────────────────────────────────────────
    uint rotA   = _OtherA.Load(idxA * OtherStride(scaleFmtA));
    uint rotB   = _OtherB.Load(idxB * OtherStride(scaleFmtB));
    float4 qA   = DecodeRot(rotA);
    float4 qB   = DecodeRot(rotB);
    // Ensure shortest path slerp
    if (dot(qA, qB) < 0) qB = -qB;
    float4 qOut = normalize(lerp(qA, qB, t));

    float3 scaleNormA = DecodeVec(_OtherA, idxA * OtherStride(scaleFmtA) + 4, scaleFmtA);
    float3 scaleNormB = DecodeVec(_OtherB, idxB * OtherStride(scaleFmtB) + 4, scaleFmtB);
    float3 scaleA = DecodeChunkScale(scaleNormA, _ChunksA, _ChunkCountA, idxA);
    float3 scaleB = DecodeChunkScale(scaleNormB, _ChunksB, _ChunkCountB, idxB);
    float3 scaleOut = lerp(scaleA, scaleB, t);

    _OutOther.Store(i * OUT_OTHER_STRIDE,     EncodeRot(qOut));
    _OutOther.Store(i * OUT_OTHER_STRIDE + 4, EncodeNorm6(EncodeChunkScale(scaleOut)));

    // ── Color ──────────────────────────────────────────────────────────────
    uint2 coordA   = SplatToTexCoord(idxA, _OutWidth);   // A tex sized same as output
    uint2 coordB   = SplatToTexCoord(idxB, _OutWidthB);  // B tex may have a different width
    uint2 coordOut = SplatToTexCoord(i,    _OutWidth);
    float4 colA = DecodeChunkColor(_ColorA.Load(int3(coordA, 0)), _ChunksA, _ChunkCountA, idxA);
    float4 colB = DecodeChunkColor(_ColorB.Load(int3(coordB, 0)), _ChunksB, _ChunkCountB, idxB);
    _OutColor[coordOut] = EncodeOutputColor(lerp(colA, colB, t));

    // ── SH — passthrough A (clustered SH lerp deferred to morph/runtime) ─────
    // TODO: proper SH lerp once formats are normalised across both assets.
    // For now the output SH buffer is a copy of A (set at OnEnable via CopyBuffer).
}

// ── CopyUnmatchedA ────────────────────────────────────────────────────────────
// Copies unmatched Left splats to output at [_OutOffset + i], scaling opacity by (1 - _T).
// At t=0 these splats are fully visible; at t=1 they are gone.
[numthreads(64, 1, 1)]
void CopyUnmatchedA(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _UnmatchedCount) return;

    uint srcIdx = (uint)_UnmatchedIndices[i];
    uint dstIdx = _OutOffset + i;

    uint posFmtA   = _SplatFormatA & 0xFF;
    uint scaleFmtA = (_SplatFormatA >> 8) & 0xFF;

    // ── Position — dechunk and re-normalise into output bounds ───────────────
    float3 normPos  = DecodeVec(_PosA, srcIdx * PosStride(posFmtA), posFmtA);
    float3 worldPos = Dechunk(normPos, _ChunksA, _ChunkCountA, srcIdx);
    float3 range    = max(_OutBoundsMax - _OutBoundsMin, 1e-6);
    float3 normOut  = saturate((worldPos - _OutBoundsMin) / range);
    _OutPos.Store(dstIdx * 4, EncodeNorm11(normOut));

    // ── Other (rotation + scale) — re-encode for the output's identity chunk bounds ──
    uint rotEnc    = _OtherA.Load(srcIdx * OtherStride(scaleFmtA));
    float3 scaleNorm = DecodeVec(_OtherA, srcIdx * OtherStride(scaleFmtA) + 4, scaleFmtA);
    float3 scale   = DecodeChunkScale(scaleNorm, _ChunksA, _ChunkCountA, srcIdx);
    _OutOther.Store(dstIdx * OUT_OTHER_STRIDE,     rotEnc);
    _OutOther.Store(dstIdx * OUT_OTHER_STRIDE + 4, EncodeNorm6(EncodeChunkScale(scale)));

    // ── Color — decode A's chunk-relative color, scale opacity by (1 - t), re-encode ──
    uint2 coordSrc = SplatToTexCoord(srcIdx, _OutWidth);
    uint2 coordDst = SplatToTexCoord(dstIdx, _OutWidth);
    float4 col = DecodeChunkColor(_ColorA.Load(int3(coordSrc, 0)), _ChunksA, _ChunkCountA, srcIdx);
    col.a *= (1.0 - _T);
    _OutColor[coordDst] = EncodeOutputColor(col);
}

// ── CopyUnmatchedB ────────────────────────────────────────────────────────────
// Copies unmatched Right splats to output at [_OutOffset + i], scaling opacity by _T.
// At t=0 these splats are invisible; at t=1 they are fully visible.
[numthreads(64, 1, 1)]
void CopyUnmatchedB(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _UnmatchedCount) return;

    uint srcIdx = (uint)_UnmatchedIndices[i];
    uint dstIdx = _OutOffset + i;

    uint posFmtB   = _SplatFormatB & 0xFF;
    uint scaleFmtB = (_SplatFormatB >> 8) & 0xFF;

    // ── Position ─────────────────────────────────────────────────────────────
    float3 normPos  = DecodeVec(_PosB, srcIdx * PosStride(posFmtB), posFmtB);
    float3 worldPos = Dechunk(normPos, _ChunksB, _ChunkCountB, srcIdx);
    float3 range    = max(_OutBoundsMax - _OutBoundsMin, 1e-6);
    float3 normOut  = saturate((worldPos - _OutBoundsMin) / range);
    _OutPos.Store(dstIdx * 4, EncodeNorm11(normOut));

    // ── Other ────────────────────────────────────────────────────────────────
    uint rotEnc      = _OtherB.Load(srcIdx * OtherStride(scaleFmtB));
    float3 scaleNorm = DecodeVec(_OtherB, srcIdx * OtherStride(scaleFmtB) + 4, scaleFmtB);
    float3 scale     = DecodeChunkScale(scaleNorm, _ChunksB, _ChunkCountB, srcIdx);
    _OutOther.Store(dstIdx * OUT_OTHER_STRIDE,     rotEnc);
    _OutOther.Store(dstIdx * OUT_OTHER_STRIDE + 4, EncodeNorm6(EncodeChunkScale(scale)));

    // ── Color — decode B's chunk-relative color, scale opacity by t, re-encode ──
    uint2 coordSrc = SplatToTexCoord(srcIdx, _OutWidthB);
    uint2 coordDst = SplatToTexCoord(dstIdx, _OutWidth);
    float4 col = DecodeChunkColor(_ColorB.Load(int3(coordSrc, 0)), _ChunksB, _ChunkCountB, srcIdx);
    col.a *= _T;
    _OutColor[coordDst] = EncodeOutputColor(col);
}
