float4x4 _MatrixObjectToWorld;
float4x4 _MatrixWorldToObject;
float4x4 _MatrixVP;
float4x4 _MatrixMV;
float4x4 _MatrixP;
float4 _VecScreenParams;
float4 _VecWorldSpaceCameraPos;
int _SelectionMode;

// World-space frustum planes (xyz = normal, w = distance), from GeometryUtility.CalculateFrustumPlanes(cam) --
// same source as the CPU-side per-renderer frustum cull in GatherSplatsForCamera. Unity's plane convention:
// a point is on the frustum's inside/positive side when dot(normal, point) + distance >= 0.
float4 _FrustumPlanes[6];

RWStructuredBuffer<uint> _SplatSortDistances;
RWStructuredBuffer<uint> _SplatSortKeys;
uint _SplatCount;
int _InvertSort;

// radix sort etc. friendly, see http://stereopsis.com/radix.html
uint FloatToSortableUint(float f)
{
    uint fu = asuint(f);
    uint mask = -((int)(fu >> 31)) | 0x80000000;
    return fu ^ mask;
}

[numthreads(GROUP_SIZE,1,1)]
void CSSetIndices (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    _SplatSortKeys[idx] = idx;
}

[numthreads(GROUP_SIZE,1,1)]
void CSCalcDistances (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    uint origIdx = _SplatSortKeys[idx];

    float3 pos = LoadSplatPos(origIdx);
    pos = mul(_MatrixMV, float4(pos.xyz, 1)).xyz;

    uint key = FloatToSortableUint(pos.z);
    _SplatSortDistances[idx] = _InvertSort ? ~key : key;
}

RWStructuredBuffer<SplatViewData> _SplatViewData;

// Effect layer stacking — Option A: one buffer, one dispatch, N layers looped per splat
StructuredBuffer<SplatEffectParams> _EffectLayers;
uint _EffectLayerCount;

float _SplatScale;
float _SplatOpacityScale;
uint _SHOrder;
uint _SHOnly;
// Debug: when > 0, forces every splat's world-space scale to this uniform value on all 3 axes,
// bypassing decoded per-splat scale entirely. Used to isolate scale-variation-driven visual artifacts
// (e.g. camera-ray-grid patterns becoming visible) from position/rotation causes.
float _DebugForceSplatSize;
// Debug: when >= 0, forces every splat's alpha to this fixed value, bypassing decoded per-splat opacity.
float _DebugForceSplatAlpha;
float _ContributionCullThreshold;

// Hotspot LOD — uploaded by GaussianSplatRenderer when GaussianHotspotVolume components are present.
// Each float4: xyz = world-space position, w = unused.
// Parallel arrays: _HotspotFullRadius[i] and _HotspotAttenuationRadius[i] match _Hotspots[i].
// When _HotspotCount == 0 the plain _ContributionCullThreshold path is taken instead.
#define MAX_HOTSPOTS 8
uint _HotspotCount;
float4 _HotspotPositions[MAX_HOTSPOTS];
float _HotspotFullRadius[MAX_HOTSPOTS];
float _HotspotAttenuationRadius[MAX_HOTSPOTS];

// Debug visualization: when enabled, overrides splat color with nearest-hotspot distance
// (green = at/inside fullRadius, red = at/beyond attenuationRadius). Diagnostic only.
uint _HotspotDebugVisualize;

// Debug-only: returns the normalized [0,1] ramp fraction to the nearest hotspot
// (0 = at/inside its fullRadius, 1 = at/beyond its attenuationRadius) for color visualization.
float HotspotDebugFraction(float3 worldPos)
{
    float bestFraction = 1.0f;
    for (uint i = 0; i < _HotspotCount; ++i)
    {
        float d     = distance(worldPos, _HotspotPositions[i].xyz);
        float fullR = _HotspotFullRadius[i];
        float attR  = _HotspotAttenuationRadius[i];
        float fraction = (attR > fullR) ? saturate((d - fullR) / (attR - fullR)) : (d > fullR ? 1.0f : 0.0f);
        bestFraction = min(bestFraction, fraction);
    }
    return bestFraction;
}

// Returns the effective contribution-cull threshold for a splat at worldPos given the
// registered hotspots. Finds the nearest hotspot and maps distance to a threshold:
//   dist <= fullRadius       → baseThreshold (no change)
//   fullRadius < dist < attRadius → smoothstep ramp from baseThreshold up to 1.0
//   dist >= attRadius        → 2.0 (guaranteed above any opacity, forces cull)
float HotspotCullThreshold(float3 worldPos, float baseThreshold)
{
    if (_HotspotCount == 0)
        return baseThreshold;

    // A splat survives if it is within range of ANY hotspot, not just the nearest —
    // evaluate each hotspot's own ramp independently, take the most permissive (lowest) threshold.
    float bestThreshold = 2.0f;
    for (uint i = 0; i < _HotspotCount; ++i)
    {
        float d     = distance(worldPos, _HotspotPositions[i].xyz);
        float fullR = _HotspotFullRadius[i];
        float attR  = _HotspotAttenuationRadius[i];

        float t;
        if (d <= fullR)
            t = baseThreshold;
        else if (d >= attR)
            t = 2.0f;
        else
            t = lerp(baseThreshold, 1.0f, smoothstep(fullR, attR, d));
        bestThreshold = min(bestThreshold, t);
    }
    return bestThreshold;
}

uint _SplatCutoutsCount;

#define SPLAT_CUTOUT_TYPE_ELLIPSOID 0
#define SPLAT_CUTOUT_TYPE_BOX 1

struct GaussianCutoutShaderData // match GaussianCutout.ShaderData in C#
{
    float4x4 mat;
    uint typeAndFlags;
    int cutIndices[8];
};
StructuredBuffer<GaussianCutoutShaderData> _SplatCutouts;

RWByteAddressBuffer _SplatSelectedBits;
ByteAddressBuffer _SplatDeletedBits;
uint _SplatBitsValid;

void DecomposeCovariance(float3 cov2d, out float2 v1, out float2 v2)
{
    #if 0 // does not quite give the correct results?

    // https://jsfiddle.net/mattrossman/ehxmtgw6/
    // References:
    // - https://www.youtube.com/watch?v=e50Bj7jn9IQ
    // - https://en.wikipedia.org/wiki/Eigenvalue_algorithm#2%C3%972_matrices
    // - https://people.math.harvard.edu/~knill/teaching/math21b2004/exhibits/2dmatrices/index.html
    float a = cov2d.x;
    float b = cov2d.y;
    float d = cov2d.z;
    float det = a * d - b * b; // matrix is symmetric, so "c" is same as "b"
    float trace = a + d;

    float mean = 0.5 * trace;
    float dist = sqrt(mean * mean - det);

    float lambda1 = mean + dist; // 1st eigenvalue
    float lambda2 = mean - dist; // 2nd eigenvalue

    if (b == 0) {
        // https://twitter.com/the_ross_man/status/1706342719776551360
        if (a > d) v1 = float2(1, 0);
        else v1 = float2(0, 1);
    } else
        v1 = normalize(float2(b, d - lambda2));

    v1.y = -v1.y;
    // The 2nd eigenvector is just a 90 degree rotation of the first since Gaussian axes are orthogonal
    v2 = float2(v1.y, -v1.x);

    // scaling components
    v1 *= sqrt(lambda1);
    v2 *= sqrt(lambda2);

    float radius = 1.5;
    v1 *= radius;
    v2 *= radius;

    #else

    // same as in antimatter15/splat
    float diag1 = cov2d.x, diag2 = cov2d.z, offDiag = cov2d.y;
    float mid = 0.5f * (diag1 + diag2);
    float radius = length(float2((diag1 - diag2) / 2.0, offDiag));
    float lambda1 = mid + radius;
    float lambda2 = max(mid - radius, 0.1);
    float2 diagVec = normalize(float2(offDiag, lambda1 - diag1));
    diagVec.y = -diagVec.y;
    float maxSize = 4096.0;
    v1 = min(sqrt(2.0 * lambda1), maxSize) * diagVec;
    v2 = min(sqrt(2.0 * lambda2), maxSize) * float2(diagVec.y, -diagVec.x);

    #endif
}

bool IncludedInLayers(int cutRanges[], const int idx)
{
    bool included = false;
    included = included || (idx >= cutRanges[0] && idx < cutRanges[1]);
    included = included || (idx >= cutRanges[2] && idx < cutRanges[3]);
    included = included || (idx >= cutRanges[4] && idx < cutRanges[5]);
    included = included || (idx >= cutRanges[6] && idx < cutRanges[7]);
    return included;
}



bool IsSplatCutAtLayer(float3 pos, const int idx)
{
    bool finalCut = false;
    for (uint i = 0; i < _SplatCutoutsCount; ++i)
    {
        GaussianCutoutShaderData cutData = _SplatCutouts[i];
        uint type = cutData.typeAndFlags & 0xFF;
        if (type == 0xFF) // invalid/null cutout, ignore
            continue;

        bool included = false;
        included = included || (idx >= cutData.cutIndices[0] && idx < cutData.cutIndices[1]);
        included = included || (idx >= cutData.cutIndices[2] && idx < cutData.cutIndices[3]);
        included = included || (idx >= cutData.cutIndices[4] && idx < cutData.cutIndices[5]);
        included = included || (idx >= cutData.cutIndices[6] && idx < cutData.cutIndices[7]);

        if (idx >= 0 && !included) continue;
        
        bool invert = (cutData.typeAndFlags & 0xFF00) != 0;

        float3 cutoutPos = mul(cutData.mat, float4(pos, 1)).xyz;
        if (type == SPLAT_CUTOUT_TYPE_ELLIPSOID)
        {
            if (dot(cutoutPos, cutoutPos) <= 1) return invert;
        }
        if (type == SPLAT_CUTOUT_TYPE_BOX)
        {
            if (all(abs(cutoutPos) <= 1)) return invert;
        }
        finalCut |= !invert;
    }
    return finalCut;
}
/*
bool IsSplatCut(float3 pos) { return false;IsSplatCutAtLayer(pos, -1);}
*/



bool IsSplatCut(float3 pos)
{
    bool finalCut = false;
    for (uint i = 0; i < _SplatCutoutsCount; ++i)
    {
        GaussianCutoutShaderData cutData = _SplatCutouts[i];
        uint type = cutData.typeAndFlags & 0xFF;
        if (type == 0xFF) // invalid/null cutout, ignore
            continue;
        bool invert = (cutData.typeAndFlags & 0xFF00) != 0;

        float3 cutoutPos = mul(cutData.mat, float4(pos, 1)).xyz;
        if (type == SPLAT_CUTOUT_TYPE_ELLIPSOID)
        {
            if (dot(cutoutPos, cutoutPos) <= 1) return invert;
        }
        if (type == SPLAT_CUTOUT_TYPE_BOX)
        {
            if (all(abs(cutoutPos) <= 1)) return invert;
        }
        finalCut |= !invert;
    }
    return finalCut;
}

// Atomic counter of splats surviving per-splat culling in CSCalcViewData, for measuring cull effectiveness.
RWStructuredBuffer<uint> _CullSurvivorCounter;

[numthreads(GROUP_SIZE,1,1)]
void CSCalcViewData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    SplatData splat = LoadSplatData(idx);
    SplatViewData view = (SplatViewData)0;

    float4 effectColorOverride;
    GSPLAT_APPLY_EFFECTS(splat, effectColorOverride);

    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(splat.pos,1)).xyz;
    // UNITY_MATRIX_VP, not the explicitly-passed _MatrixVP: UNITY_MATRIX_VP resolves per-eye during stereo XR
    // instanced rendering (matches the vertex shader's own UNITY_MATRIX_VP use), while _MatrixVP is uploaded
    // once per CalcViewData call from a single mono Camera and is identical for both eyes -- using it here
    // caused a per-eye clip-position mismatch (splats positioned/culled with one matrix, reprojected correctly
    // per-eye downstream), visible on Quest/OpenXR as the whole world warping inward toward the viewer.
    // _MatrixVP still exists for the frustum-plane cull below and other explicit uses in this file.
    float4 centerClipPos = mul(UNITY_MATRIX_VP, float4(centerWorldPos, 1));
    half opacityScale = _SplatOpacityScale;
    float splatScale = _SplatScale;

    // deleted?
    if (_SplatBitsValid)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        uint wordVal = _SplatDeletedBits.Load(wordIdx * 4);
        if (wordVal & (1 << bitIdx))
        {
            centerClipPos.w = 0;
        }
    }

    // cutouts
    if (IsSplatCutAtLayer(splat.pos, idx))
    {
        centerClipPos.w = 0;
    }

    view.pos = centerClipPos;

    // Per-splat cull. Two independent reasons, combined with OR:
    // (1) deleted/cutout above already forced centerClipPos.w=0 -- checked directly, not derived from any
    //     other flag; (2) bounding-sphere-vs-frustum test: world-space sphere (radius = margin * max scale
    //     axis, object-to-world scale via the object-space basis vector lengths) tested against the same
    //     6 world-space planes GeometryUtility.CalculateFrustumPlanes(cam) produces for the CPU-side
    //     per-renderer cull in GatherSplatsForCamera -- a real plane-vs-sphere test, not a clip-space margin
    //     approximation. Splat survives only if the sphere is at least partially inside every plane.
    float3 worldScaleAxis = mul((float3x3)_MatrixObjectToWorld, splat.scale);
    float worldRadius = splatScale * max(max(abs(worldScaleAxis.x), abs(worldScaleAxis.y)), abs(worldScaleAxis.z));
    const float kCullMargin = 1.5;
    worldRadius *= kCullMargin;

    bool outsideFrustum = false;
    [unroll]
    for (int planeIdx = 0; planeIdx < 6; planeIdx++)
    {
        float4 plane = _FrustumPlanes[planeIdx];
        float signedDist = dot(plane.xyz, centerWorldPos) + plane.w;
        if (signedDist < -worldRadius)
        {
            outsideFrustum = true;
            break;
        }
    }

    bool splatCulled = centerClipPos.w <= 0 || outsideFrustum;
    if (splatCulled)
        view.pos.w = 0;

    if (!splatCulled)
    {
        float4 boxRot = splat.rot;
        float3 boxSize = splat.scale;
        if (_DebugForceSplatSize > 0)
            boxSize = _DebugForceSplatSize.xxx;

        float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(boxRot, boxSize);

        float3 cov3d0, cov3d1;
        CalcCovariance3D(splatRotScaleMat, cov3d0, cov3d1);
        float splatScale2 = splatScale * splatScale;
        cov3d0 *= splatScale2;
        cov3d1 *= splatScale2;
        //float3 cov2d = CalcCovariance2D(splat.pos, cov3d0, cov3d1, _MatrixMV, _MatrixP, _VecScreenParams);
        float3 cov2d = CalcCovariance2D(splat.pos, cov3d0, cov3d1, _MatrixMV, UNITY_MATRIX_P, _VecScreenParams);
        
        DecomposeCovariance(cov2d, view.axis1, view.axis2);

        float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos;
        float3 objViewDir = mul((float3x3)_MatrixWorldToObject, worldViewDir);
        objViewDir = normalize(objViewDir);

        half4 col;
        col.rgb = ShadeSH(splat.sh, objViewDir, _SHOrder, _SHOnly != 0);
        if (effectColorOverride.a >= 0)
            col.rgb = (half3)effectColorOverride.rgb;
        col.a = _DebugForceSplatAlpha >= 0 ? _DebugForceSplatAlpha : min(splat.opacity * opacityScale, 65000);

        if (_HotspotDebugVisualize != 0 && _HotspotCount > 0)
        {
            float debugFraction = HotspotDebugFraction(centerWorldPos);
            col.rgb = (half3)lerp(half3(0,1,0), half3(1,0,0), debugFraction);
        }

        // Cull splats below threshold before rasterization (more efficient than fragment discard).
        // When hotspots are present the threshold is raised for splats far from all of them.
        float cullThreshold = HotspotCullThreshold(centerWorldPos, _ContributionCullThreshold);
        if (col.a < cullThreshold)
        {
            view.pos.w = 0;
            _SplatViewData[idx] = view;
            return;
        }

        view.color.x = (f32tof16(col.r) << 16) | f32tof16(col.g);
        view.color.y = (f32tof16(col.b) << 16) | f32tof16(col.a);

        // Counts every splat surviving deleted/cutout/frustum/contribution culling. Must stay inside this
        // block: splatCulled==true skips straight to _SplatViewData[idx]=view below without returning, so a
        // counter placed after this block would count culled splats as survivors.
        uint _unusedCounterIndex;
        InterlockedAdd(_CullSurvivorCounter[0], 1, _unusedCounterIndex);
    }

    _SplatViewData[idx] = view;
}


RWByteAddressBuffer _DstBuffer;
ByteAddressBuffer _SrcBuffer;
uint _BufferSize;

uint2 GetSplatIndicesFromWord(uint idx)
{
    uint idxStart = idx * 32;
    uint idxEnd = min(idxStart + 32, _SplatCount);
    return uint2(idxStart, idxEnd);
}

[numthreads(GROUP_SIZE,1,1)]
void CSUpdateEditData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;

    uint valSel = _SplatSelectedBits.Load(idx * 4);
    uint valDel = _SplatDeletedBits.Load(idx * 4);
    valSel &= ~valDel; // don't count deleted splats as selected
    uint2 splatIndices = GetSplatIndicesFromWord(idx);

    // update selection bounds
    float3 bmin = 1.0e38;
    float3 bmax = -1.0e38;
    uint mask = 1;
    uint valCut = 0;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        // don't count cut splats as selected
        if (IsSplatCut(spos))
        {
            valSel &= ~mask;
            valCut |= mask;
        }
        if (valSel & mask)
        {
            bmin = min(bmin, spos);
            bmax = max(bmax, spos);
        }
    }
    valCut &= ~valDel; // don't count deleted splats as cut

    if (valSel != 0)
    {
        _DstBuffer.InterlockedMin(12, FloatToSortableUint(bmin.x));
        _DstBuffer.InterlockedMin(16, FloatToSortableUint(bmin.y));
        _DstBuffer.InterlockedMin(20, FloatToSortableUint(bmin.z));
        _DstBuffer.InterlockedMax(24, FloatToSortableUint(bmax.x));
        _DstBuffer.InterlockedMax(28, FloatToSortableUint(bmax.y));
        _DstBuffer.InterlockedMax(32, FloatToSortableUint(bmax.z));
    }
    uint sumSel = countbits(valSel);
    uint sumDel = countbits(valDel);
    uint sumCut = countbits(valCut);
    _DstBuffer.InterlockedAdd(0, sumSel);
    _DstBuffer.InterlockedAdd(4, sumDel);
    _DstBuffer.InterlockedAdd(8, sumCut);
}

[numthreads(1,1,1)]
void CSInitEditData (uint3 id : SV_DispatchThreadID)
{
    _DstBuffer.Store3(0, uint3(0,0,0)); // selected, deleted, cut counts
    uint initMin = FloatToSortableUint(1.0e38);
    uint initMax = FloatToSortableUint(-1.0e38);
    _DstBuffer.Store3(12, uint3(initMin, initMin, initMin));
    _DstBuffer.Store3(24, uint3(initMax, initMax, initMax));
}

[numthreads(GROUP_SIZE,1,1)]
void CSClearBuffer (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    _DstBuffer.Store(idx * 4, 0);
}

[numthreads(GROUP_SIZE,1,1)]
void CSInvertSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint v = _DstBuffer.Load(idx * 4);
    v = ~v;

    // do not select splats that are cut
    uint2 splatIndices = GetSplatIndicesFromWord(idx);
    uint mask = 1;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        if (IsSplatCut(spos))
            v &= ~mask;
    }

    _DstBuffer.Store(idx * 4, v);
}

[numthreads(GROUP_SIZE,1,1)]
void CSSelectAll (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint v = ~0;

    // do not select splats that are cut
    uint2 splatIndices = GetSplatIndicesFromWord(idx);
    uint mask = 1;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        if (IsSplatCut(spos))
            v &= ~mask;
    }

    _DstBuffer.Store(idx * 4, v);
}


[numthreads(GROUP_SIZE,1,1)]
void CSOrBuffers (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint a = _SrcBuffer.Load(idx * 4);
    uint b = _DstBuffer.Load(idx * 4);
    _DstBuffer.Store(idx * 4, a | b);
}

float4 _SelectionRect;

[numthreads(GROUP_SIZE,1,1)]
void CSSelectionUpdate (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 pos = LoadSplatPos(idx);
    if (IsSplatCut(pos))
        return;

    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
    float4 centerClipPos = mul(_MatrixVP, float4(centerWorldPos, 1));
    bool behindCam = centerClipPos.w <= 0;
    if (behindCam)
        return;

    float2 pixelPos = (centerClipPos.xy / centerClipPos.w * float2(0.5, -0.5) + 0.5) * _VecScreenParams.xy;
    if (pixelPos.x < _SelectionRect.x || pixelPos.x > _SelectionRect.z ||
        pixelPos.y < _SelectionRect.y || pixelPos.y > _SelectionRect.w)
    {
        return;
    }
    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    if (_SelectionMode)
        _SplatSelectedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx); // +
    else
        _SplatSelectedBits.InterlockedAnd(wordIdx * 4, ~(1u << bitIdx)); // -
}

float3 _SelectionDelta;

bool IsSplatSelected(uint idx)
{
    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    uint selVal = _SplatSelectedBits.Load(wordIdx * 4);
    return (selVal & (1 << bitIdx)) != 0;
}

[numthreads(GROUP_SIZE,1,1)]
void CSTranslateSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint stride = 12;
        float3 pos = asfloat(_SplatPos.Load3(idx * stride));
        pos += _SelectionDelta;
        _SplatPos.Store3(idx * stride, asuint(pos));
    }
}

float3 _SelectionCenter;
float4 _SelectionDeltaRot;
ByteAddressBuffer _SplatPosMouseDown;
ByteAddressBuffer _SplatOtherMouseDown;

[numthreads(GROUP_SIZE,1,1)]
void CSRotateSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint posFmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && posFmt == VECTOR_FMT_32F)
    {
        uint posStride = 12;
        float3 pos = asfloat(_SplatPosMouseDown.Load3(idx * posStride));
        pos -= _SelectionCenter;
        pos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
        pos = QuatRotateVector(pos, _SelectionDeltaRot);
        pos = mul(_MatrixWorldToObject, float4(pos,1)).xyz;
        pos += _SelectionCenter;
        _SplatPos.Store3(idx * posStride, asuint(pos));
    }

    uint scaleFmt = (_SplatFormat >> 8) & 0xFF;
    uint shFormat = (_SplatFormat >> 16) & 0xFF;
    if (_SplatChunkCount == 0 && scaleFmt == VECTOR_FMT_32F && shFormat == VECTOR_FMT_32F)
    {
        uint otherStride = 4 + 12;
        uint rotVal = _SplatOtherMouseDown.Load(idx * otherStride);
        float4 rot = DecodeRotation(DecodePacked_10_10_10_2(rotVal));

        //@TODO: correct rotation
        rot = QuatMul(rot, _SelectionDeltaRot);

        rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(rot));
        _SplatOther.Store(idx * otherStride, rotVal);
    }

    //@TODO: rotate SHs
}

//@TODO: maybe scale the splat scale itself too?
[numthreads(GROUP_SIZE,1,1)]
void CSScaleSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint stride = 12;
        float3 pos = asfloat(_SplatPosMouseDown.Load3(idx * stride));
        pos -= _SelectionCenter;
        pos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
        pos *= _SelectionDelta;
        pos = mul(_MatrixWorldToObject, float4(pos,1)).xyz;
        pos += _SelectionCenter;
        _SplatPos.Store3(idx * stride, asuint(pos));
    }
}

// Moves the splat along the world-space axis from _ViewpointPos toward/away from its own
// position, scaled by _ReprojectAmount, then rescales the splat itself by the ratio of its
// new distance to its original distance from the viewpoint so its apparent size — as seen
// from the viewpoint, assuming a perspective projection — stays visually constant. Scale
// resize only applies when the asset's scale (and SH, since it shares _SplatOther's layout)
// format is Float32, matching the position-edit precedent (CSTranslateSelection etc. already
// gate the same way) — editable assets already imply Float32 across the board since
// CanBeEdited() requires chunkDataSize == 0. Reuses the _SplatOtherMouseDown buffer already
// declared above (near CSRotateSelection) — one global declaration per compute file.
float3 _ViewpointPos;
float _ReprojectAmount;

[numthreads(GROUP_SIZE,1,1)]
void CSReprojectSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint posFmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || posFmt != VECTOR_FMT_32F)
        return;

    uint posStride = 12;
    float3 pos = asfloat(_SplatPosMouseDown.Load3(idx * posStride));
    float3 worldPos = mul(_MatrixObjectToWorld, float4(pos, 1)).xyz;
    float3 toSplat = worldPos - _ViewpointPos;
    float originalDist = length(toSplat);
    float3 axis = originalDist > 1e-6 ? toSplat / originalDist : float3(0, 0, 1);
    worldPos += axis * _ReprojectAmount;
    pos = mul(_MatrixWorldToObject, float4(worldPos, 1)).xyz;
    _SplatPos.Store3(idx * posStride, asuint(pos));

    uint scaleFmt = (_SplatFormat >> 8) & 0xFF;
    uint shFormat = (_SplatFormat >> 16) & 0xFF;
    if (scaleFmt == VECTOR_FMT_32F && shFormat == VECTOR_FMT_32F && originalDist > 1e-6)
    {
        float newDist = length(worldPos - _ViewpointPos);
        float ratio = newDist / originalDist;

        uint otherStride = 4 + 12; // rotation (10.10.10.2) + scale (32F float3)
        uint otherAddr = idx * otherStride;
        float3 scale = asfloat(_SplatOtherMouseDown.Load3(otherAddr + 4));
        scale *= ratio;
        _SplatOther.Store3(otherAddr + 4, asuint(scale));
    }
}

struct ExportSplatData
{
    float3 pos;
    float3 nor;
    float3 dc0;
    float4 shR14; float4 shR58; float4 shR9C; float3 shRDF;
    float4 shG14; float4 shG58; float4 shG9C; float3 shGDF;
    float4 shB14; float4 shB58; float4 shB9C; float3 shBDF;
    float opacity;
    float3 scale;
    float4 rot;
};
RWStructuredBuffer<ExportSplatData> _ExportBuffer;

float3 ColorToSH0(float3 col)
{
    return (col - 0.5) / 0.2820948;
}
float InvSigmoid(float v)
{
    return log(v / max(1 - v, 1.0e-6));
}

// SH rotation
#include "Packages/com.worldlabs.gaussian-splatting/Shaders/SphericalHarmonics.hlsl"

void RotateSH(inout SplatSHData sh, float3x3 rot)
{
    float3 shin[16];
    float3 shout[16];
    shin[0] = sh.col;
    shin[1] = sh.sh1;
    shin[2] = sh.sh2;
    shin[3] = sh.sh3;
    shin[4] = sh.sh4;
    shin[5] = sh.sh5;
    shin[6] = sh.sh6;
    shin[7] = sh.sh7;
    shin[8] = sh.sh8;
    shin[9] = sh.sh9;
    shin[10] = sh.sh10;
    shin[11] = sh.sh11;
    shin[12] = sh.sh12;
    shin[13] = sh.sh13;
    shin[14] = sh.sh14;
    shin[15] = sh.sh15;
    RotateSH(rot, 4, shin, shout);
    sh.col = shout[0];
    sh.sh1 = shout[1];
    sh.sh2 = shout[2];
    sh.sh3 = shout[3];
    sh.sh4 = shout[4];
    sh.sh5 = shout[5];
    sh.sh6 = shout[6];
    sh.sh7 = shout[7];
    sh.sh8 = shout[8];
    sh.sh9 = shout[9];
    sh.sh10 = shout[10];
    sh.sh11 = shout[11];
    sh.sh12 = shout[12];
    sh.sh13 = shout[13];
    sh.sh14 = shout[14];
    sh.sh15 = shout[15];
}

float3x3 CalcSHRotMatrix(float4x4 objToWorld)
{
    float3x3 m = (float3x3)objToWorld;
    float sx = length(float3(m[0][0], m[0][1], m[0][2]));
    float sy = length(float3(m[1][0], m[1][1], m[1][2]));
    float sz = length(float3(m[2][0], m[2][1], m[2][2]));

    float invSX = 1.0 / sx;
    float invSY = 1.0 / sy;
    float invSZ = 1.0 / sz;

    m[0][0] *= invSX;
    m[0][1] *= invSX;
    m[0][2] *= invSX;
    m[1][0] *= invSY;
    m[1][1] *= invSY;
    m[1][2] *= invSY;
    m[2][0] *= invSZ;
    m[2][1] *= invSZ;
    m[2][2] *= invSZ;
    return m;
}


float4 _ExportTransformRotation;
float3 _ExportTransformScale;
uint _ExportTransformFlags;

[numthreads(GROUP_SIZE,1,1)]
void CSExportData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    SplatData src = LoadSplatData(idx);

    bool isCut = IsSplatCut(src.pos);

    // transform splat by matrix, if needed
    if (_ExportTransformFlags != 0)
    {
        src.pos = mul(_MatrixObjectToWorld, float4(src.pos,1)).xyz;

        // note: this only handles axis flips from scale, not any arbitrary scaling
        if (_ExportTransformScale.x < 0)
            src.rot.yz = -src.rot.yz;
        if (_ExportTransformScale.y < 0)
            src.rot.xz = -src.rot.xz;
        if (_ExportTransformScale.z < 0)
            src.rot.xy = -src.rot.xy;
        src.rot = QuatMul(_ExportTransformRotation, src.rot);
        src.scale *= abs(_ExportTransformScale);

        float3x3 shRot = CalcSHRotMatrix(_MatrixObjectToWorld);
        RotateSH(src.sh, shRot);
    }

    ExportSplatData dst;
    dst.pos = src.pos;
    dst.nor = 0;
    dst.dc0 = ColorToSH0(src.sh.col);
    
    dst.shR14 = float4(src.sh.sh1.r, src.sh.sh2.r, src.sh.sh3.r, src.sh.sh4.r);
    dst.shR58 = float4(src.sh.sh5.r, src.sh.sh6.r, src.sh.sh7.r, src.sh.sh8.r);
    dst.shR9C = float4(src.sh.sh9.r, src.sh.sh10.r, src.sh.sh11.r, src.sh.sh12.r);
    dst.shRDF = float3(src.sh.sh13.r, src.sh.sh14.r, src.sh.sh15.r);
    
    dst.shG14 = float4(src.sh.sh1.g, src.sh.sh2.g, src.sh.sh3.g, src.sh.sh4.g);
    dst.shG58 = float4(src.sh.sh5.g, src.sh.sh6.g, src.sh.sh7.g, src.sh.sh8.g);
    dst.shG9C = float4(src.sh.sh9.g, src.sh.sh10.g, src.sh.sh11.g, src.sh.sh12.g);
    dst.shGDF = float3(src.sh.sh13.g, src.sh.sh14.g, src.sh.sh15.g);
    
    dst.shB14 = float4(src.sh.sh1.b, src.sh.sh2.b, src.sh.sh3.b, src.sh.sh4.b);
    dst.shB58 = float4(src.sh.sh5.b, src.sh.sh6.b, src.sh.sh7.b, src.sh.sh8.b);
    dst.shB9C = float4(src.sh.sh9.b, src.sh.sh10.b, src.sh.sh11.b, src.sh.sh12.b);
    dst.shBDF = float3(src.sh.sh13.b, src.sh.sh14.b, src.sh.sh15.b);
    
    dst.opacity = InvSigmoid(src.opacity);
    dst.scale = log(src.scale);
    dst.rot = src.rot.wxyz;

    if (isCut)
        dst.nor = 1; // mark as skipped for export
    
    _ExportBuffer[idx] = dst;
}

RWByteAddressBuffer _CopyDstPos;
RWByteAddressBuffer _CopyDstOther;
RWByteAddressBuffer _CopyDstSH;
RWByteAddressBuffer _CopyDstEditDeleted;
RWTexture2D<float4> _CopyDstColor;
uint _CopyDstSize, _CopySrcStartIndex, _CopyDstStartIndex, _CopyCount;

float4x4 _CopyTransformMatrix;
float4 _CopyTransformRotation;
float3 _CopyTransformScale;

[numthreads(GROUP_SIZE,1,1)]
void CSCopySplats (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _CopyCount)
        return;
    uint srcIdx = _CopySrcStartIndex + idx;
    uint dstIdx = _CopyDstStartIndex + idx;
    if (srcIdx >= _SplatCount || dstIdx >= _CopyDstSize)
        return;

    SplatData src = LoadSplatData(idx);

    // transform the splat
    src.pos = mul(_CopyTransformMatrix, float4(src.pos,1)).xyz;
    // note: this only handles axis flips from scale, not any arbitrary scaling
    if (_CopyTransformScale.x < 0)
        src.rot.yz = -src.rot.yz;
    if (_CopyTransformScale.y < 0)
        src.rot.xz = -src.rot.xz;
    if (_CopyTransformScale.z < 0)
        src.rot.xy = -src.rot.xy;
    src.rot = QuatMul(_CopyTransformRotation, src.rot);
    src.scale *= abs(_CopyTransformScale);

    float3x3 shRot = CalcSHRotMatrix(_CopyTransformMatrix);
    RotateSH(src.sh, shRot);

    // output data into destination:
    // pos
    uint posStride = 12;
    _CopyDstPos.Store3(dstIdx * posStride, asuint(src.pos));
    // rot + scale
    uint otherStride = 4 + 12;
    uint rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(src.rot));
    _CopyDstOther.Store4(dstIdx * otherStride, uint4(
        rotVal,
        asuint(src.scale.x),
        asuint(src.scale.y),
        asuint(src.scale.z)));
    // color
    uint3 pixelIndex = SplatIndexToPixelIndex(dstIdx);
    _CopyDstColor[pixelIndex.xy] = float4(src.sh.col, src.opacity);

    // SH
    uint shStride = 192; // 15*3 fp32, rounded up to multiple of 16
    uint shOffset = dstIdx * shStride;
    _CopyDstSH.Store3(shOffset + 12 * 0, asuint(src.sh.sh1));
    _CopyDstSH.Store3(shOffset + 12 * 1, asuint(src.sh.sh2));
    _CopyDstSH.Store3(shOffset + 12 * 2, asuint(src.sh.sh3));
    _CopyDstSH.Store3(shOffset + 12 * 3, asuint(src.sh.sh4));
    _CopyDstSH.Store3(shOffset + 12 * 4, asuint(src.sh.sh5));
    _CopyDstSH.Store3(shOffset + 12 * 5, asuint(src.sh.sh6));
    _CopyDstSH.Store3(shOffset + 12 * 6, asuint(src.sh.sh7));
    _CopyDstSH.Store3(shOffset + 12 * 7, asuint(src.sh.sh8));
    _CopyDstSH.Store3(shOffset + 12 * 8, asuint(src.sh.sh9));
    _CopyDstSH.Store3(shOffset + 12 * 9, asuint(src.sh.sh10));
    _CopyDstSH.Store3(shOffset + 12 * 10, asuint(src.sh.sh11));
    _CopyDstSH.Store3(shOffset + 12 * 11, asuint(src.sh.sh12));
    _CopyDstSH.Store3(shOffset + 12 * 12, asuint(src.sh.sh13));
    _CopyDstSH.Store3(shOffset + 12 * 13, asuint(src.sh.sh14));
    _CopyDstSH.Store3(shOffset + 12 * 14, asuint(src.sh.sh15));

    // deleted bits
    uint srcWordIdx = srcIdx / 32;
    uint srcBitIdx = srcIdx & 31;
    if (_SplatDeletedBits.Load(srcWordIdx * 4) & (1u << srcBitIdx))
    {
        uint dstWordIdx = dstIdx / 32;
        uint dstBitIdx = dstIdx & 31;
        _CopyDstEditDeleted.InterlockedOr(dstWordIdx * 4, 1u << dstBitIdx);
    }
}

// Delete selected splats filtered by opacity and distance from selection center.
// density  [0..1]: SHAPE — decides which splats are candidates. At 1 all selected splats are candidates; at 0 nothing is.
//                  within candidates, high-opacity splats survive, low-opacity splats are affected (or gated by position roll in Position mode).
// hardness [0..1]: INTENSITY — at 1, candidates get a hard delete (today's behavior). At <1, candidates instead get a
//                  partial opacity reduction (written to _SplatOpacityMultRW), position-weighted: full Hardness-driven
//                  reduction at the selection center, fading all the way to invisible at the selection edge.
float _DeleteDensity;
float _DeleteHardness;
float3 _DeleteSelectionCenter;  // world space
float3 _DeleteSelectionExtents; // world space, always > 0
int _DeleteUsePosition; // 0 = gate on opacity (default), 1 = gate on a deterministic per-splat random roll (dithering)
RWByteAddressBuffer _SplatDeletedBitsRW;
RWStructuredBuffer<float> _SplatOpacityMultRW;

// PCG hash — deterministic per-splat-index random value in [0,1), no seed: same index always rolls the same way.
float HashIndexToUnitFloat(uint idx)
{
    uint state = idx * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return (float)word / 4294967295.0;
}

// Same PCG hash, but salted with a per-dispatch seed (XOR'd into the index) — re-rolling the same splat
// differently across repeated dispatches (e.g. successive brush strokes at the same density).
float HashIndexToUnitFloatSeeded(uint idx, uint seed)
{
    return HashIndexToUnitFloat(idx ^ seed);
}

[numthreads(GROUP_SIZE,1,1)]
void CSDeleteSelectedWithParams (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;

    uint selVal = _SplatSelectedBits.Load(wordIdx * 4);
    if (!(selVal & (1u << bitIdx)))
        return;

    uint delVal = _SplatDeletedBitsRW.Load(wordIdx * 4);
    if (delVal & (1u << bitIdx))
        return;

    SplatData s = LoadSplatData(idx);

    // Use raw GPU position space — same as LoadSplatPosValue, matching rawCenter/rawExtents from C#.
    // Ellipsoid radial distance (not a box max) — follows the selection's actual extents shape,
    // so bounding-box corners aren't falsely treated as "deep in the selection."
    float3 localOffset = ((float3)s.pos - _DeleteSelectionCenter) / _DeleteSelectionExtents;
    float t = saturate(length(localOffset)); // 0 = selection center, 1 = selection edge

    // Density alone decides candidacy (position-based falloff) — Hardness no longer folds into this threshold.
    // Density curve: skewed so slider feels linear in splat-count space.
    float t0 = 1.0 - pow(1.0 - _DeleteDensity, 3.0);
    float threshold = smoothstep(0.0, 1.0, t0);

    bool isCandidate;
    if (_DeleteUsePosition != 0)
    {
        // Position mode: real dithering — each splat independently rolls against the density threshold, ignoring opacity.
        float roll = HashIndexToUnitFloat(idx);
        isCandidate = roll < threshold;
    }
    else
    {
        float opacity = (float)s.opacity;
        isCandidate = opacity <= threshold;
    }

    if (!isCandidate)
        return;

    // Hardness decides INTENSITY for candidates: at Hardness=1, hard delete (today's behavior).
    // At Hardness<1, candidates get a partial opacity reduction instead — position-weighted so
    // edge-of-selection candidates (t near 1) fade more than center candidates (t near 0) at the same Hardness.
    if (_DeleteHardness >= 1.0)
    {
        _SplatDeletedBitsRW.InterlockedOr(wordIdx * 4, 1u << bitIdx);
    }
    else
    {
        // Position-weighted intensity: Hardness=0 means almost no effect (opacity stays ~1 everywhere).
        // As Hardness rises toward 1, edge candidates (t near 1) fade toward transparent faster than
        // center candidates (t near 0) — Hardness scales HOW MUCH the position falloff can reduce opacity.
        float opacityMult = saturate(1.0 - _DeleteHardness * t);
        _SplatOpacityMultRW[idx] = opacityMult;
    }
}

// Screen-space brush: selects splats whose projection falls within a screen-pixel circle.
// _BrushCenter:   brush center in screen pixels
// _BrushRadius:   brush radius in screen pixels
// World-space brush: selects splats within a 3D sphere.
// _BrushCenterWorld: sphere center in world space
// _BrushRadiusWorld: sphere radius in world space
// _SelectionMode: 1 = add, 0 = subtract (shared by both kernels)
// _BrushDensity [0..1]: fraction of splats inside the brush that actually get (de)selected — dithered via HashIndexToUnitFloatSeeded, 1 = every touched splat.
// _BrushSeed: per-dispatch salt so repeated strokes at the same density roll differently each time, instead of always missing/hitting the same splats.
// _BrushColorModeActive: when nonzero, a candidate must pass HSL-delta color matching BEFORE density gets a
// say — density then dithers WITHIN the color-matched set (AND gate), rather than across the whole stroke.
// _BrushRefColorHsl: reference color (sampled via CSPickSplatColor) pre-converted to HSL on the C# side.
// _BrushColorTolHsl: per-channel (H, S, L) tolerance — a candidate must be within tolerance on ALL three to pass.
float2 _BrushCenter;
float _BrushRadius;
float3 _BrushCenterWorld;
float _BrushRadiusWorld;
float _BrushDensity;
uint _BrushSeed;
uint _BrushColorModeActive;
float3 _BrushRefColorHsl;
float3 _BrushColorTolHsl;

// Standard RGB->HSL. H in [0,1) (wrapped), S and L in [0,1].
float3 RgbToHsl(float3 c)
{
    float maxc = max(c.r, max(c.g, c.b));
    float minc = min(c.r, min(c.g, c.b));
    float l = (maxc + minc) * 0.5;
    float d = maxc - minc;

    float h = 0.0;
    float s = 0.0;
    if (d > 1e-6)
    {
        s = d / (1.0 - abs(2.0 * l - 1.0) + 1e-6);
        if (maxc == c.r)
            h = fmod((c.g - c.b) / d, 6.0);
        else if (maxc == c.g)
            h = (c.b - c.r) / d + 2.0;
        else
            h = (c.r - c.g) / d + 4.0;
        h /= 6.0;
        if (h < 0.0) h += 1.0;
    }
    return float3(h, s, l);
}

// True if candidate HSL is within tolerance of the reference on all three channels.
// Hue wraps circularly (0 and 1 are adjacent), saturation/lightness do not.
bool ColorMatchesHsl(float3 candidateHsl)
{
    float dh = abs(candidateHsl.x - _BrushRefColorHsl.x);
    dh = min(dh, 1.0 - dh); // circular wrap
    float ds = abs(candidateHsl.y - _BrushRefColorHsl.y);
    float dl = abs(candidateHsl.z - _BrushRefColorHsl.z);
    return dh <= _BrushColorTolHsl.x && ds <= _BrushColorTolHsl.y && dl <= _BrushColorTolHsl.z;
}

[numthreads(GROUP_SIZE,1,1)]
void CSBrushSelect (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 pos = LoadSplatPos(idx);
    if (IsSplatCut(pos))
        return;

    // Project splat to screen space — identical to CSSelectionUpdate.
    float3 worldPos = mul(_MatrixObjectToWorld, float4(pos, 1)).xyz;
    float4 clipPos  = mul(_MatrixVP, float4(worldPos, 1));
    if (clipPos.w <= 0)
        return;

    float2 pixelPos = (clipPos.xy / clipPos.w * float2(0.5, -0.5) + 0.5) * _VecScreenParams.xy;
    float2 delta = pixelPos - _BrushCenter;
    if (dot(delta, delta) > _BrushRadius * _BrushRadius)
        return;

    // Already deleted — never re-select. Deleted splats keep their index (no compaction), so without this
    // check a stroke over a region with dead splats burns density budget re-marking permanently-invisible ghosts.
    uint delWordIdx = idx / 32;
    uint delBitIdx = idx & 31;
    if (_SplatDeletedBits.Load(delWordIdx * 4) & (1u << delBitIdx))
        return;

    // Color match is a hard gate: candidate must match before density even gets a say.
    if (_BrushColorModeActive)
    {
        float3 hsl = RgbToHsl(LoadSplatColTex(SplatIndexToPixelIndex(idx)).rgb);
        if (!ColorMatchesHsl(hsl))
            return;
    }

    // Density dithers within whatever passed the color gate above (or the whole stroke, if color mode is off).
    if (HashIndexToUnitFloatSeeded(idx, _BrushSeed) >= _BrushDensity)
        return;

    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    if (_SelectionMode)
        _SplatSelectedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx);
    else
        _SplatSelectedBits.InterlockedAnd(wordIdx * 4, ~(1u << bitIdx));
}

[numthreads(GROUP_SIZE,1,1)]
void CSBrushSelectWorld (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 pos = LoadSplatPos(idx);
    if (IsSplatCut(pos))
        return;

    float3 worldPos = mul(_MatrixObjectToWorld, float4(pos, 1)).xyz;

    // World-space sphere test.
    float3 delta = worldPos - _BrushCenterWorld;
    if (dot(delta, delta) > _BrushRadiusWorld * _BrushRadiusWorld)
        return;

    // Depth occlusion: reject splats behind the sphere (further from camera than center + radius).
    // Uses linear camera-space depth to avoid NDC non-linearity issues.
    float4 splatView  = mul(_MatrixMV, float4(worldPos, 1));
    float4 centerView = mul(_MatrixMV, float4(_BrushCenterWorld, 1));
    // In view space, -Z is forward. Larger -Z = further away.
    float splatDist  = -splatView.z;
    float centerDist = -centerView.z;
    if (splatDist > centerDist + _BrushRadiusWorld)
        return;

    // Already deleted — never re-select (see CSBrushSelect for why).
    uint delWordIdx = idx / 32;
    uint delBitIdx = idx & 31;
    if (_SplatDeletedBits.Load(delWordIdx * 4) & (1u << delBitIdx))
        return;

    // Color match is a hard gate: candidate must match before density even gets a say.
    if (_BrushColorModeActive)
    {
        float3 hsl = RgbToHsl(LoadSplatColTex(SplatIndexToPixelIndex(idx)).rgb);
        if (!ColorMatchesHsl(hsl))
            return;
    }

    // Density dithers within whatever passed the color gate above (or the whole stroke, if color mode is off).
    if (HashIndexToUnitFloatSeeded(idx, _BrushSeed) >= _BrushDensity)
        return;

    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    if (_SelectionMode)
        _SplatSelectedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx);
    else
        _SplatSelectedBits.InterlockedAnd(wordIdx * 4, ~(1u << bitIdx));
}

// Screen-space color pick: finds the splat nearest to a click pixel (within _PickRadius) and writes its
// base color (SH DC term from the color texture, not full view-dependent SH) to _PickResultRW.
// _PickResultRW layout: [0] = packed (distanceBucket << 19 | idx), MUST be initialized to 0xFFFFFFFF by
// the caller before dispatch so InterlockedMin can find the true nearest; [1..4] = winning splat's RGBA
// color as asuint-packed floats, written only by the thread that successfully wins the InterlockedMin race
// (checked by reading back [0] after the atomic and comparing to this thread's own packed value).
float2 _PickCenter;   // screen pixels
float _PickRadius;    // screen pixels
RWByteAddressBuffer _PickResultRW; // byte offsets: 0=packed dist+idx, 4/8/12/16=RGBA (InterlockedMin needs a raw buffer, not RWStructuredBuffer)

[numthreads(GROUP_SIZE,1,1)]
void CSPickSplatColor (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 pos = LoadSplatPos(idx);
    if (IsSplatCut(pos))
        return;

    float3 worldPos = mul(_MatrixObjectToWorld, float4(pos, 1)).xyz;
    float4 clipPos  = mul(_MatrixVP, float4(worldPos, 1));
    if (clipPos.w <= 0)
        return;

    float2 pixelPos = (clipPos.xy / clipPos.w * float2(0.5, -0.5) + 0.5) * _VecScreenParams.xy;
    float2 delta = pixelPos - _PickCenter;
    float distSq = dot(delta, delta);
    if (distSq > _PickRadius * _PickRadius)
        return;

    // Already deleted — never pick a color from a splat that's gone.
    uint delWordIdxP = idx / 32;
    uint delBitIdxP = idx & 31;
    if (_SplatDeletedBits.Load(delWordIdxP * 4) & (1u << delBitIdxP))
        return;

    // Quantize distSq into the top 13 bits (far hits beyond the quantization range clamp to the max
    // bucket — only loses fine ordering among hits already outside a sane _PickRadius), index in low 19 bits.
    uint distBucket = (uint)min(distSq * 16.0, 8191.0);
    uint packed = (distBucket << 19) | (idx & 0x7FFFF);

    uint prevMin;
    _PickResultRW.InterlockedMin(0, packed, prevMin);
    // If this thread's value is the new minimum (prevMin was larger), it won the race — write color.
    // Rare double-write races (two threads both see themselves as winner within the same dispatch) are
    // acceptable here: only ever between splats at effectively the same pixel distance, picking either is fine.
    if (packed < prevMin)
    {
        half4 col = LoadSplatColTex(SplatIndexToPixelIndex(idx));
        _PickResultRW.Store(4,  asuint((float)col.r));
        _PickResultRW.Store(8,  asuint((float)col.g));
        _PickResultRW.Store(12, asuint((float)col.b));
        _PickResultRW.Store(16, asuint((float)col.a));
    }
}
