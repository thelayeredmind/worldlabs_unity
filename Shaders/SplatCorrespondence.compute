// SPDX-License-Identifier: MIT
// Nearest-neighbor correspondence search for GaussianMorphMapBuilder.
// One thread per splat in L — finds the closest splat in R by weighted pos+color distance.
// Duplicate resolution (one-to-one constraint) is handled on CPU after readback.
//
// Raw position and color distances live on uncalibrated, non-comparable scales (position is
// normalised to [0,1] over the combined bounding box; color is raw RGBA). Summing them directly
// means colWeight/posWeight don't behave as a true blend — a splat's tiny position spread within
// its own correct cluster can be dwarfed by color's much larger contested range, so even a small
// colWeight can outvote a strongly-favoured position match (cross-cluster "swaps" for same-colored
// but spatially distant splats). Each L splat instead min-max squashes its own pos/color distances
// to [0,1] against its own candidate pool (per-splat min/max, not a global constant) before
// weighting, so posWeight=colWeight=0.5 is a genuine equal blend for THIS splat's actual spread of
// candidates. Min-max (not z-score) specifically because it's a monotonic affine transform of the
// raw distance — it can never change which candidate is closest, only rescale the gap. Z-score was
// tried first and rejected: it normalises relative to the pool MEAN rather than the query point, so
// a candidate that's merely "central"/average across the whole R set can systematically look best
// for a huge number of unrelated L splats — measured at 9.2% distinct-candidate ratio on a real
// 294912-splat asset (94908 L splats meant fewer than that many distinct R destinations, mass
// convergence onto ~27k R splats), which cascaded into the many-to-one remainder resolver picking
// up the >200k splats the round loop could never actually resolve.

#pragma kernel FindBestMatch

StructuredBuffer<float4> _SplatsL;   // xyz=position (normalised), w=unused
StructuredBuffer<float4> _ColorsL;   // rgba color
StructuredBuffer<float4> _SplatsR;
StructuredBuffer<float4> _ColorsR;

RWStructuredBuffer<int>   _BestMatchIndex;   // output: per L splat, best R index
RWStructuredBuffer<float> _BestMatchDist;    // output: per L splat, best distance (min-max squashed blend) — for candidate SELECTION only
RWStructuredBuffer<float> _BestMatchRawDist; // output: per L splat, raw (non-normalised) squared distance to the chosen candidate —
                                              // normalised values are relative to each splat's own candidate pool and are NOT comparable
                                              // across different L splats; cross-splat collision arbitration (ResolveOneToOne) must use
                                              // this raw value instead, or "closest pair wins" becomes meaningless noise.

int   _CountL;
int   _CountR;
float _PosWeight;
float _ColWeight;

[numthreads(64, 1, 1)]
void FindBestMatch(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if ((int)i >= _CountL) return;

    float3 pl = _SplatsL[i].xyz;
    float4 cl = _ColorsL[i];

    // Pass 1: find min/max raw pos/color distance over this splat's full R pool.
    float minPos = 1e30f, maxPos = 0;
    float minCol = 1e30f, maxCol = 0;

    for (int j = 0; j < _CountR; j++)
    {
        float3 dp = pl - _SplatsR[j].xyz;
        float4 dc = cl - _ColorsR[j];
        float dPos = dot(dp, dp);
        float dCol = dot(dc, dc);

        minPos = min(minPos, dPos); maxPos = max(maxPos, dPos);
        minCol = min(minCol, dCol); maxCol = max(maxCol, dCol);
    }

    // max(..., 1e-12) guards a degenerate pool (every candidate equidistant on this axis) from a
    // div-by-zero; such a splat has no discriminating signal on that axis either way.
    float rangePos = max(maxPos - minPos, 1e-12f);
    float rangeCol = max(maxCol - minCol, 1e-12f);

    // Pass 2: recompute distances, min-max squash each to [0,1] against this splat's own pool
    // range, weight-blend. Monotonic in the raw distance, so argmin here always matches argmin of
    // the raw distance for a FIXED weight split on a single axis — unlike z-score, this can't let a
    // pool-average-adjacent candidate outrank the true nearest neighbor.
    float bestDist    = 1e30f;
    float bestRawDist = 0;
    int   bestJ       = 0;

    for (int k = 0; k < _CountR; k++)
    {
        float3 dp = pl - _SplatsR[k].xyz;
        float4 dc = cl - _ColorsR[k];
        float dPos = dot(dp, dp);
        float dCol = dot(dc, dc);

        float nPos = (dPos - minPos) / rangePos;
        float nCol = (dCol - minCol) / rangeCol;
        float dist = _PosWeight * nPos + _ColWeight * nCol;

        if (dist < bestDist)
        {
            bestDist    = dist;
            bestRawDist = _PosWeight * dPos + _ColWeight * dCol;
            bestJ       = k;
        }
    }

    _BestMatchIndex[i]   = bestJ;
    _BestMatchDist[i]    = bestDist;
    _BestMatchRawDist[i] = bestRawDist;
}

// Top-K candidate list per L splat: same 2-pass min-max blended distance as FindBestMatch, but
// keeps the best TOP_K candidates instead of collapsing to a single winner. Used by diagnostics
// (Verify Top-K Matches Kernel) and available as a building block for future matching strategies
// that need more than one candidate per L splat.
#pragma kernel FindTopKMatches

#define TOP_K 32

RWStructuredBuffer<int>   _TopKIndex; // size CountL * TOP_K, per-splat candidates ordered best-first
RWStructuredBuffer<float> _TopKDist;  // size CountL * TOP_K, min-max squashed blended distance, same semantics as _BestMatchDist

[numthreads(64, 1, 1)]
void FindTopKMatches(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if ((int)i >= _CountL) return;

    float3 pl = _SplatsL[i].xyz;
    float4 cl = _ColorsL[i];

    float minPos = 1e30f, maxPos = 0;
    float minCol = 1e30f, maxCol = 0;

    for (int j = 0; j < _CountR; j++)
    {
        float3 dp = pl - _SplatsR[j].xyz;
        float4 dc = cl - _ColorsR[j];
        float dPos = dot(dp, dp);
        float dCol = dot(dc, dc);

        minPos = min(minPos, dPos); maxPos = max(maxPos, dPos);
        minCol = min(minCol, dCol); maxCol = max(maxCol, dCol);
    }

    float rangePos = max(maxPos - minPos, 1e-12f);
    float rangeCol = max(maxCol - minCol, 1e-12f);

    // Fixed-size sorted insert: topDist[0..count) ascending, topIdx parallel. Linear insertion is
    // fine here — TOP_K is small (32) relative to the O(CountR) outer loop it's nested inside.
    float topDist[TOP_K];
    int   topIdx[TOP_K];
    int   count = 0;

    for (int k = 0; k < _CountR; k++)
    {
        float3 dp = pl - _SplatsR[k].xyz;
        float4 dc = cl - _ColorsR[k];
        float dPos = dot(dp, dp);
        float dCol = dot(dc, dc);

        float nPos = (dPos - minPos) / rangePos;
        float nCol = (dCol - minCol) / rangeCol;
        float dist = _PosWeight * nPos + _ColWeight * nCol;

        if (count < TOP_K || dist < topDist[TOP_K - 1])
        {
            int insertAt = min(count, TOP_K - 1);
            while (insertAt > 0 && topDist[insertAt - 1] > dist)
            {
                topDist[insertAt] = topDist[insertAt - 1];
                topIdx[insertAt]  = topIdx[insertAt - 1];
                insertAt--;
            }
            topDist[insertAt] = dist;
            topIdx[insertAt]  = k;
            count = min(count + 1, TOP_K);
        }
    }

    for (int s = 0; s < TOP_K; s++)
    {
        uint outBase = i * TOP_K + s;
        if (s < count)
        {
            _TopKIndex[outBase] = topIdx[s];
            _TopKDist[outBase]  = topDist[s];
        }
        else
        {
            // CountR < TOP_K: pad with an invalid sentinel so consumers can detect short lists.
            _TopKIndex[outBase] = -1;
            _TopKDist[outBase]  = 1e30f;
        }
    }
}
